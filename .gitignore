# ---------------------------------------------------------------------------
# Virtual environment -- thousands of files, hundreds of MB. Never commit.
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Generated data. All of this is reproducible from build_dataset.py in ~10 min,
# so committing it wastes repo space and risks blowing GitHub's 100 MB
# per-file limit. Anyone cloning runs the build themselves.
# ---------------------------------------------------------------------------
data/
*.npz
*.npy
*.mat

# ---------------------------------------------------------------------------
# Checkpoints and intermediates
# ---------------------------------------------------------------------------
*_ckpt.npz
*_preds.npz
shards/
unseen/

# ---------------------------------------------------------------------------
# Exception: the reconstructed test-set predictions are the evidence behind the
# per-class metrics in results/per_class_snr/. They are labels only (yte, yp,
# ste) -- 68 KB for all eleven files -- so they are committed deliberately, so
# that every reported per-class / per-SNR number can be recomputed from the
# repository alone. See docs/PER_CLASS_SNR_EVALUATION.md.
# ---------------------------------------------------------------------------
!results/preds/
!results/preds/*.npz

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
exp4.log
nohup.out

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
